1.Write a sample SQL statement with single row subquery.
CREATE TABLE ORDERS(
  PROD_ID INT PRIMARY KEY,
  PROD_NAME VARCHAR(20) NOT NULL,
  PROD_PRICE INT NOT NULL);
  
  INSERT INTO ORDERS VALUES
  (1,'SHAMPOO',200),
  (2,'RICE',500),
  (3,'SOAP',250),
  (4,'OIL',300),
  (5,'PILLOW',600),
  (6,'MUSHROOM',100);
  
  SELECT PROD_NAME,PROD_PRICE FROM ORDERS WHERE PROD_PRICE = (SELECT MAX(PROD_PRICE) FROM ORDERS);

2.Write a sample SQL statement with multi row subquery.
CREATE TABLE ORDERS(
  PROD_ID INT PRIMARY KEY,
  PROD_NAME VARCHAR(20) NOT NULL,
  PROD_PRICE INT NOT NULL);
  
  INSERT INTO ORDERS VALUES
  (1,'SHAMPOO',200),
  (2,'RICE',500),
  (3,'SOAP',250),
  (4,'OIL',300),
  (5,'PILLOW',600),
  (6,'MUSHROOM',100);

  SELECT PROD_NAME, PROD_PRICE
FROM ORDERS
WHERE PROD_PRICE IN (
    SELECT PROD_PRICE 
    FROM ORDERS 
    WHERE PROD_PRICE >= 300
);

3. Write a SQL statement with correlated subquery.

CREATE TABLE ORDERS(
  PROD_ID INT PRIMARY KEY,
  PROD_NAME VARCHAR(20) NOT NULL,
  PROD_PRICE INT NOT NULL);
  
  INSERT INTO ORDERS VALUES
  (1,'SHAMPOO',200),
  (2,'RICE',500),
  (3,'SOAP',250),
  (4,'OIL',300),
  (5,'PILLOW',600),
  (6,'MUSHROOM',100);

SELECT PROD_NAME, PROD_PRICE
FROM ORDERS o1
WHERE PROD_PRICE > (
    SELECT AVG(o2.PROD_PRICE)
    FROM ORDERS o2
    WHERE o2.PROD_ID <> o1.PROD_ID
);

