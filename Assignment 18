1.Navigate to https://www.hyrtutorials.com/ and mouse hover to "Tutorials" menu and click "Dot Net" submenu
package practiceselenium;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;
import java.time.Duration;

public class HoverAndClick {

    public static void main(String[] args) {
       
        WebDriver driver = new ChromeDriver();
        
        driver.manage().window().maximize();

        driver.get("https://www.hyrtutorials.com/");

        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(5));

        WebElement tutorialsMenu = driver.findElement(By.xpath("//a[text()='Tutorials']"));

        WebElement dotNetSubMenu = driver.findElement(By.xpath("//a[text()='Dot Net']"));

        Actions actions = new Actions(driver);

        actions.moveToElement(tutorialsMenu)
               .moveToElement(dotNetSubMenu)
               .click()
               .build()
               .perform();
      
    }
}

2.Navigate to https://www.saucedemo.com/, copy "locked_out_user" from "Accepted usernames are:"
and paste it into Username text field, same way copy and paste the password in Password field and click Login.

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;

public class ActionsAssignment {

    public static void main(String[] args) throws InterruptedException {

        String url = "https://www.saucedemo.com/";
        String userName = "user-name";
        String password = "password";
        String loginButton = "login-button";
        String credentials = "login_credentials";
        String passcredentials ="//div[@class='login_password']";
        WebElement Username,Password,Login,LoginCredentials,PasswordCredentials;

        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        driver.get(url);
        Username =driver.findElement(By.id(userName));
        Password =driver.findElement(By.id(password));
        Login = driver.findElement(By.id(loginButton));
        LoginCredentials=driver.findElement(By.id(credentials));
        PasswordCredentials =driver.findElement(By.xpath(passcredentials));
        
        
        Actions mouseActions = new Actions(driver);
        mouseActions.moveToElement(LoginCredentials).doubleClick().keyDown(Keys.CONTROL).sendKeys("c").keyUp(Keys.CONTROL).perform();
        mouseActions.moveToElement(Username).click().keyDown(Keys.CONTROL).sendKeys("v").keyUp(Keys.CONTROL).perform();
        mouseActions.moveToElement(PasswordCredentials).click().keyDown(Keys.CONTROL).sendKeys("c").keyUp(Keys.CONTROL).perform();
        mouseActions.moveToElement(Password).click().keyDown(Keys.CONTROL).sendKeys("v").keyUp(Keys.CONTROL).perform();
        mouseActions.moveToElement(Login).click().perform();


        
        
    }

}


